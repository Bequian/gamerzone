# Copia este archivo como ".env" y reemplaza los valores. El archivo .env NUNCA se sube a Git.
# Genera valores seguros con:  openssl rand -base64 24   (y para el JWT: openssl rand -base64 32)

MYSQL_ROOT_PASSWORD='cambiar'
DB_PASSWORD='cambiar'

GZ_USER_PASSWORD='cambiar'
GZ_ADMIN_PASSWORD='cambiar'
GZ_ORGANIZADOR_PASSWORD='cambiar'

# Base64 de 32 bytes: openssl rand -base64 32
GZ_JWT_SECRET='cambiar'